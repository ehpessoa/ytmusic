# Copy this file to .env and fill in your own values. Never commit the real .env.

# API key for the Gemini API, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used to classify each track as Pop or Rock
GEMINI_MODEL=gemini-2.5-flash

# Path to the ytmusicapi auth file (see README for how to generate it)
YTMUSIC_AUTH_FILE=oauth.json

# Name of the source playlist to read from your YouTube Music library
SOURCE_PLAYLIST_NAME=Best Pop Rock Ever

# Names of the two playlists this tool creates/updates
POP_PLAYLIST_NAME=Best Pop Ever
ROCK_PLAYLIST_NAME=Best Rock Ever
